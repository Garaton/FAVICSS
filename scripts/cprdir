#!/bin/bash


# Usage
if [[ "$1" == *"-"*"h"* ]] then
	echo "Usage: cprdir [flags] [quality #]"
	echo "Flags:"
	echo "	h - Help"
	echo "	y - Force yes"
	echo "	v - Include videos (videos take a while)"
	echo "	f - Include fonts (requires fontconv)"
	echo "	q - Check for Quality #"
	echo "		Quality #: Used by ffmpeg for images"
	echo "	c - Uses more cores to try and compress files more"
	echo
	echo "EX: cprdir -yqv 0"
	exit
fi

# Cancellation checks
# If we skip, skip
if ! [[ "$1" == *"-"*"y"* ]] then
	echo "This will change images, audio, and maybe videos, found within:"
	echo "	$(pwd)"
	read -p "Are you sure you wish to proceed (y/n): " input

	if ! [[ "$input" == "y" ]] then
		exit
	fi
fi


# Setting up temp directory name
tempdir="temp-compressing-$RANDOM"

# Setting up functions
# Find smallest value in tmp, or $f
minTmp() {
	local min=$(stat -c%s "$f")
	local minFile=$f
	local size=0
	for tempFile in "$tempdir/"*
	do
		size=$(stat -c%s "$tempFile")
		if (( $size < $min )) && ! (( $size == 0 )) then
			min=$size
			minFile=$tempFile
		fi
	done

	# Returning minimum
	echo "$minFile"
}


# Parameter checks
qual=25
if [[ "$1" == *"-"*"q"* ]] && ! [[ -z $2 ]] then
	qual=$2
fi
do_vid=false
if [[ "$1" == *"-"*"v"* ]] then
	do_vid=true
fi

do_font=false
if [[ "$1" == *"-"*"f"* ]] then
	font_which="$(which fontconv)" # I give up on trying to remove this error output
	if [[ -z $font_which ]] then
		echo "Dependency \"fontconv\" not found if you wish to compress fonts please refer to README.md."
		echo "	Continuing without font compression."
	else
		do_font=true
	fi
fi



# Starting script
mkdir "$tempdir"

find . -type f | while read file
do
	# Fixing file just because easier to do it like this
	f="$(find | grep "$file")"

	CMP=0 # Did we compress
	EXT="" # What file format do we export it as

	# Compressing
	# Image Case
	if [[ "$f" == *".png"* ]] || [[ "$f" == *".jpg"* ]] || [[ "$f" == *".jpeg"* ]] || [[ "$f" == *".webp"* ]] then
		# Current Winner: webp, qual 25, comp 2: 21.3 -> 12.5 MB
		#	0 quality does COMPRESS, but you don't notice 25 quality
		if ! [[ "$1" == *"-"*"c"* ]] then
			ffmpeg -i "$f" -c:v libwebp -compression_level 2 -quality "$qual" "$tempdir/1.webp" -loglevel error -y < /dev/null
		else
			ffmpeg -i "$f" -c:v libwebp -compression_level 2 -quality "$qual" "$tempdir/1.webp" -loglevel error -y < /dev/null & PID1=$!
			ffmpeg -i "$f" -c:v libwebp -compression_level 4 -quality "$qual" "$tempdir/2.webp" -loglevel error -y < /dev/null & PID2=$!
			ffmpeg -i "$f" -c:v libwebp -compression_level 2 -quality 50 "$tempdir/3.webp" -loglevel error -y < /dev/null & PID3=$!
			ffmpeg -i "$f" -c:v libwebp -compression_level 2 -quality 80 "$tempdir/4.webp" -loglevel error -y < /dev/null & PID4=$!
			wait "$PID1"
			wait "$PID2"
			wait "$PID3"
			wait "$PID4"
		fi
		CMP=1
		EXT=".webp"

	# Audio Case
	elif [[ "$f" == *".wav"* ]] || [[ "$f" == *".flac"* ]] || [[ "$f" == *".ogg"* ]] || [[ "$f" == *".mp3"* ]] then
		# Current winner: ogg, -c:a libvorbis -ab 32k -ar 22050 -b:a 96k: 310.2 -> 93.8 MiB
		if ! [[ "$1" == *"-"*"c"* ]] then
			ffmpeg -i "$f" -c:a libvorbis -ab 32k -ar 22050 -b:a 96k "$tempdir/1.ogg" -loglevel error -y < /dev/null
		else
			ffmpeg -i "$f" -c:a libvorbis -ab 32k -ar 22050 -b:a 96k "$tempdir/1.ogg" -loglevel error -y < /dev/null & PID1=$!
			ffmpeg -i "$f" -b:a 96k "$tempdir/2.ogg" -loglevel error -y < /dev/null & PID2=$!
			wait "$PID1"
			wait "$PID2"
		fi
		CMP=1
		EXT=".ogg"
	
	# Video Case
	elif $do_vid && ( [[ "$f" == *".webm"* ]] || [[ "$f" == *".mp4"* ]] || [[ "$f" == *".mov"* ]] ) then
		echo "Compressing Video: $f"
		ffmpeg -i "$f" -c:v libvpx -b:v 1M -crf 30 -c:a libopus "$tempdir/1.webm" -loglevel error -y < /dev/null
		CMP=1
		EXT=".webm"

	# Font Case
	elif $do_font && [[ "$f" == *".ttf"* ]] then
		fontconv "$f" "$tempdir/1.otf"
		CMP=1
		EXT=".otf"
	fi

	# If we compressed and it's smaller replace
	if [[ $CMP == 1 ]] then
		# Get the smallest file
		smallFile=$(minTmp)
		if ! [[ "$smallFile" == "$f" ]] then
			echo "Compressed: $f	$(stat -c%s "$f") -> $(stat -c%s "$smallFile")" # Print the file
			mv "$smallFile" "$f"
		fi

		# Cleanup Temp
		if [[ "$1" == *"-"*"c"* ]] || [[ "$smallFile" == "$f" ]] then
			rm "$tempdir/"*
		fi
	fi
done

# Cleanup
rmdir "$tempdir"
