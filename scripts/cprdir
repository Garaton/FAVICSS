#!/bin/bash
set -euo pipefail
IFS=$'\n\t'

# Usage
usage() {
	echo "Usage: cprdir [flags] [quality #]"
	echo "File compression utility which uses FFMPEG to compress lots of files for you."
	echo
	echo "Flags:"
	echo "	h - Help"
	echo "	y - Force yes"
	echo "	b - Compress in a different directory (copies the entire directory over)"
	echo "	v - Include videos (videos take a while)"
	echo "	f - Include fonts (requires fontconv)"
	echo "	c - Uses more cores to try and compress files more"
	echo "	l - For lossless"
	echo "	q - Check for Quality # (must be last flag)"
	echo "		Quality #: Used by ffmpeg for images (0 lowest, 100 highest)"
	echo
	echo "EX: cprdir -yvq 0"
	exit 1
}

# Cancellation checks
# Do we have ffmpeg
if [[ -z "$(command -v ffmpeg)" ]]; then
	echo "Error: Missing dependency \"ffmpeg\"."
	usage
fi

# Argument parsing
yes=false
backup=false
do_vid=false
do_font=false
dont_core_max=true
lossless=0
jxl_distance=6
qual=25
while getopts ":hybvfclq:" opt; do
	case $opt in
		h) usage;;
		y) yes=true;;
		b) backup=true;;
		v) do_vid=true;;
		f)
			if [[ -z "$(command -v fontconv)" ]]; then
				echo "Error: Dependency \"fontconv\" not found if you wish to compress fonts please refer to README.md.">&2
				usage
			else
				do_font=true
			fi
			;;
		c) dont_core_max=false;;
		l) lossless=1; jxl_distance=0;;
		q)
			if [[ $OPTARG =~ ^[0-9]+$ ]]; then
				qual=$OPTARG
			else
				echo "Error: Quality value is not a number, \"$OPTARG\".">&2
				usage
			fi
			;;
		\?) echo "Error: Unknown flag \"$OPTARG\"">&2; usage;;
		:)
			echo "Error: Quality flag set, but quality value not specified.">&2
			usage
			;;
	esac
done


# Ask the user if they really want to do this
if ! $yes && ! $backup; then
	echo "This will change images, audio, and maybe videos, found within:"
	echo "	$(pwd)"
	read -p "Are you sure you wish to proceed (y/n): " input

	if [[ "$input" != "y" ]]; then
		echo "You can run this again with flag \"b\" to instead do all operations in a separate directory, thereby maintaining all of the original files."
		exit 0
	fi
fi

# Setting up temp directory name
tempdir="temp-compressing-$RANDOM"
dir_name="${PWD##*/}-compressed"

if $backup; then
	# Copy this directory into dir_name, we override already existing compressed dirs
	cp -r . "../$dir_name"
	cd "../$dir_name"
fi

# Cleanup
trap "rm -rf "$tempdir"" EXIT


# Setting up functions
# Find smallest value in tmp, or $f
min_tmp() {
	local min=$(stat -c%s "$f")
	local min_file=$f
	local size=0
	for temp_file in "$tempdir/"*
	do
		size=$(stat -c%s "$temp_file")
		if (( $size < $min )) && ! (( $size == 0 )) then
			min=$size
			min_file=$temp_file
		fi
	done

	# Returning minimum
	echo "$min_file"
}


# Checking if we have an NVIDIA GPU for fast video compression
nvidia_gpu=false
if [[ ! -z "$(lspci | grep -i nvidia)" ]]; then
	nvidia_gpu=true
fi


# Starting script
mkdir "$tempdir"
SECONDS=0

find . -type f | while read f
do
	# Tracking variables
	cmpr=0 # Did we compress
	exp="" # What file format do we export it as
	mime_type="$(file --mime-type -b "$f")"

	# Compressing
	# Image Case
	if [[ "$mime_type" == "image/"* ]]; then
		# Current Winner: webp, qual 25, comp 4
		#	0 quality does COMPRESS, but you don't notice 25 quality

		# Normal Run
		if $dont_core_max; then
			ffmpeg -i "$f" -c:v libwebp -lossless $lossless -compression_level 4 -quality "$qual" "$tempdir/p1.webp" -loglevel error -y < /dev/null
		# Trying Multiple Options Run
		else
			ffmpeg -i "$f" -c:v libwebp -lossless $lossless -compression_level 4 -quality "$qual" "$tempdir/p1.webp" -loglevel error -y < /dev/null & PID1=$!
			ffmpeg -i "$f" -c:v libjxl -distance $jxl_distance -effort 7 "$tempdir/p2.jxl" -loglevel error -y < /dev/null & PID2=$!
			wait "$PID1"
			wait "$PID2"
		fi
		cmpr=1

	# Audio Case
	elif [[ "$mime_type" == "audio/"* ]]; then
		# Current winner: ogg, -c:a libopus -ab 32k -b:a 64k
		# libopus at lower bitrate sounds about the same as libvorbis, allows higher compression

		# Lossless Run
		if (( $lossless == 1 )); then
			ffmpeg -i "$f" -c:a flac -compression_level 8 "$tempdir/a1.flac" -loglevel error -y < /dev/null
		# Normal Run
		elif $dont_core_max; then
			ffmpeg -i "$f" -c:a libopus -ab 32k -b:a 64k "$tempdir/a1.ogg" -loglevel error -y < /dev/null
		# Trying multiple options Run
		else
			ffmpeg -i "$f" -c:a libopus -ab 32k -b:a 64k "$tempdir/a1.ogg" -loglevel error -y < /dev/null & PID1=$!
			ffmpeg -i "$f" -c:a libvorbis -ab 32k -ar 22050 -b:a 96k "$tempdir/a2.ogg" -loglevel error -y < /dev/null & PID2=$!
			wait "$PID1"
			wait "$PID2"
		fi
		cmpr=1
	
	# Video Case
	elif $do_vid && [[ "$mime_type" == "video/"* ]]; then
		echo "Compressing Video: $f"
		# Lossless Run
		if (( $lossless == 1 )); then
			ffmpeg -i "$f" -map 0 -c:v ffv1 -level 3 -g 1 -slicecrc 1 -slices 24 -coder 0 -context 0 -c:a copy -c:s copy "$tempdir/v1.mkv" -loglevel error -y < /dev/null
		# GPU Accelerated Run
		elif $nvidia_gpu; then
			ffmpeg -i "$f" -c:v av1_nvenc -preset p6 -tune hq -rc vbr -cq 57 -b:v 0 -multipass fullres -c:a libopus -ab 32k -b:a 64k "$tempdir/v1.webm" -loglevel error -y < /dev/null
		# Normal Run
		else
			ffmpeg -i "$f" -c:v libsvtav1 -crf 60 -preset 6 -svtav1-params lp=4 -c:a libopus -ab 32k -b:a 64k "$tempdir/v1.webm" -loglevel error -y < /dev/null
		fi
		cmpr=1

	# Font Case
	# Scrict because fontconv is scrict, otf is already lossless
	elif $do_font && [[ "$f" == *".ttf" || "$f" == *".otf" ]]; then
		fontconv "$f" "$tempdir/f1.otf"
		cmpr=1
	fi

	# If we compressed and it's smaller replace
	if [[ $cmpr == 1 ]] then
		# Get the smallest file
		small_file=$(min_tmp)
		if [[ "$small_file" != "$f" ]]; then
			echo "Compressed: $f	$(stat -c%s "$f") -> $(stat -c%s "$small_file")	($(basename "$small_file"))" # Print the file
			mv "$small_file" "$f"
		fi
		# Cleanup temp directory
		if [[ ! -z $(ls "$tempdir") ]]; then
			rm "$tempdir/"*
		fi
	fi
done

echo "$PWD took $SECONDS."

